# 🔌 INTEGRATION POINT: مفتاح Gemini API المجاني (حد 15 طلب/دقيقة)
GEMINI_API_KEY="your_gemini_api_key_here"

# 🔌 INTEGRATION POINT: رابط مشروع Supabase (النسخة المجانية)
SUPABASE_URL="https://your-project-id.supabase.co"

# 🔌 INTEGRATION POINT: مفتاح Supabase Anon Key (للوصول العام/العميل في تطبيق Flutter)
SUPABASE_ANON_KEY="your_supabase_anon_key_here"

# 🔌 INTEGRATION POINT: مفتاح Supabase Service Role (للاستخدام داخل Edge Functions و Scraper فقط - لتخطي قواعد RLS - لا تشاركه أبداً)
SUPABASE_SERVICE_ROLE_KEY="your_supabase_service_role_key_here"

# 🔌 INTEGRATION POINT: مفتاح Resend API لإرسال رسائل البريد الإلكتروني (الخطة المجانية تكفي)
RESEND_API_KEY="your_resend_api_key_here"

# 🔌 INTEGRATION POINT: مفتاح Lemon Squeezy للتحقق من عمليات الدفع والاشتراكات
LEMON_SQUEEZY_WEBHOOK_SECRET="your_lemon_squeezy_secret_here"
